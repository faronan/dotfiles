#!/bin/bash
# config.kdl hash: {{ include "dot_config/zellij/config.kdl" | sha256sum }}
set -euo pipefail
{{ if eq .chezmoi.os "darwin" -}}
echo "Installing Zellij plugins..."
PLUGIN_DIR="${HOME}/.config/zellij/plugins"
mkdir -p "${PLUGIN_DIR}"

# zjstatus: カスタムステータスバー
if [ ! -f "${PLUGIN_DIR}/zjstatus.wasm" ]; then
    echo "  Downloading zjstatus..."
    curl -sSfL https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm \
        -o "${PLUGIN_DIR}/zjstatus.wasm" || {
        echo "⚠️  zjstatus のダウンロードに失敗しました"
    }
fi

# キャッシュクリア（プラグイン更新時に必要）
# macOS: ~/Library/Caches/org.Zellij-Contributors.Zellij/
rm -rf "${HOME}/Library/Caches/org.Zellij-Contributors.Zellij/"

echo "Zellij plugins installed."
{{ end -}}
