// ===========================================
// Dev Layout: Claude Code + yazi + terminal
// ===========================================
// Usage: zellij --layout dev
//
// ┌─────────────────────┬──────────┐
// │                     │  yazi    │
// │    Claude Code      │  (右上)   │
// │      (左側)          ├──────────┤
// │                     │ terminal │
// │                     │  (右下)   │
// └─────────────────────┴──────────┘

layout {
    pane split_direction="vertical" {
        pane size="50%" {
            command "claude"
            name "claude"
            close_on_exit false
        }
        pane size="50%" {
            pane {
                command "yazi"
                name "files"
                close_on_exit false
            }
            pane {
                name "terminal"
            }
        }
    }
}
