// ===========================================
// Dev Layout: yazi + terminal + Claude Code
// ===========================================
// Usage: zellij --layout dev
//
// ┌──────────┬─────────────────────┐
// │  yazi    │                     │
// │  (左上)   │    Claude Code      │
// ├──────────┤      (右側)          │
// │ terminal │                     │
// │  (左下)   │                     │
// └──────────┴─────────────────────┘

layout {
    pane split_direction="vertical" {
        pane size="40%" {
            pane {
                command "yazi"
                name "files"
                close_on_exit false
            }
            pane {
                name "terminal"
            }
        }
        pane size="60%" {
            command "claude"
            name "claude"
            close_on_exit false
        }
    }
}
