# ===========================================
# Ghostty Configuration
# ===========================================
# Docs: https://ghostty.org/docs/config/reference
# Reload: Cmd + Shift + , (macOS)

# --- Font ---
# Japanese + Nerd Font (Brewfile: font-hackgen-nerd)
# HackGen = Hack + GenJyuuGothic (Japanese)
font-family = "HackGen Console NF"
font-size = 14
font-thicken = true

# Disable ligatures completely (avoid Japanese display issues)
font-feature = -calt
font-feature = -dlig

# --- Visibility ---
alpha-blending = linear

# --- Background ---
background-opacity = 0.9
background-blur-radius = 20

# --- Theme ---
# Auto switch based on OS appearance
# Available themes: ghostty +list-themes
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# --- Window ---
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true
confirm-close-surface = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Mouse ---
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# --- Clipboard ---
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# 1.3.0: default copy format changed to "mixed" (text+HTML)
# Explicit text-only to keep previous behavior
keybind = cmd+c=copy_to_clipboard:text

# --- macOS Specific ---
macos-titlebar-style = tabs
macos-option-as-alt = true

# --- Quick Terminal ---
# Global hotkey: Ctrl+` to toggle (requires Accessibility permission)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1

# --- Shell Integration ---
# Fish shell integration is automatic
# no-cursor: cursor-style is manually set above, skip shell override
shell-integration-features = no-cursor,sudo,title

# --- Split ---
unfocused-split-opacity = 0.7

# --- Keybinds ---
# Prompt jump (requires shell integration OSC 133)
keybind = cmd+shift+up=jump_to_prompt:-1
keybind = cmd+shift+down=jump_to_prompt:1
# Background opacity toggle (useful for presentations)
keybind = cmd+u=toggle_background_opacity

# --- Notifications ---
# OSC 9/777 notifications (click to focus window in v1.3.0+)
desktop-notifications = true
# 1.3.0: notify when long-running commands finish
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s
